#!/usr/bin/env bash
# amun-development — Layer 4 verify (§14.1). Pure shell; no python/ansible on target.
# Confirms asdf + toolchains + claude + codex + devtools are installed.
#
#   ./verify                      # local host
#   ./verify --host HOST [--user USER]   # over SSH
set -u

HOST=""; SSH_USER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --user) SSH_USER="$2"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

run() {
  if [ -n "$HOST" ]; then ssh -o ConnectTimeout=8 -o BatchMode=yes "${SSH_USER:+$SSH_USER@}$HOST" "$1"
  else bash -c "$1"; fi
}

pass=0; fail=0
check() {  # check "label" "remote test command"
  printf '  %-50s ' "$1"
  if run "$2" >/dev/null 2>&1; then echo "PASS"; pass=$((pass + 1)); else echo "FAIL"; fail=$((fail + 1)); fi
}

# BatchMode SSH gets no login-shell profile; use explicit paths everywhere.
ASDF='command -v asdf || test -x /usr/local/bin/asdf || test -x /opt/homebrew/bin/asdf'
SHIMS='$HOME/.asdf/shims'

echo "amun-development verify${HOST:+ — $HOST}"
echo "Core:"
check "asdf binary present"      "$ASDF"
check "claude binary works"      "\$HOME/.local/bin/claude --version"
check "codex binary works"       "command -v codex >/dev/null && codex --version || /usr/local/bin/codex --version"

echo "Toolchains (via asdf shims):"
check "node"                     "$SHIMS/node --version"
check "npm"                      "PATH=$SHIMS:\$PATH $SHIMS/npm --version"
check "python 3.14"              "$SHIMS/python --version 2>&1 | grep -q 'Python 3.14'"
check "java 25"                  "$SHIMS/java -version 2>&1 | grep -q 'build 25'"
check "go"                       "$SHIMS/go version"
check "rustc"                    "$SHIMS/rustc --version"
check "~/.tool-versions has all five" "for t in nodejs python java golang rust; do grep -q \"^\$t \" \$HOME/.tool-versions || exit 1; done"

echo "Devtools:"
check "gh"                       "command -v gh"
check "fzf"                      "command -v fzf"
check "ripgrep"                  "command -v rg"
check "fd"                       "command -v fd || command -v fdfind"
check "bat"                      "command -v bat || command -v batcat"
check "jq"                       "command -v jq"
check "htop"                     "command -v htop"
check "tmux"                     "command -v tmux"
check "direnv"                   "command -v direnv"
check "lazygit"                  "command -v lazygit || test -x /usr/local/bin/lazygit"
check "git-delta"                "command -v delta"

echo
echo "PASS=$pass FAIL=$fail"
[ "$fail" -eq 0 ]
